AIM_DATABASE_URL=sqlite:///./data/monitor.db
AIM_RUNS_DIR=../runs
AIM_COVERAGE_PATH=../config/coverage/dram_hbm.yaml
AIM_FIXTURES_DIR=../fixtures
AIM_FIXED_SOURCES_PATH=../config/sources/official_sources.yaml
AIM_FETCH_AUDITS_DIR=../fetches

# Phase 2 controlled official-source fetch limits.
FIXED_FETCH_TIMEOUT_SECONDS=20
FIXED_FETCH_MAX_BYTES=2000000
FIXED_FETCH_USER_AGENT=AI-Intelligence-Monitor/0.2 (controlled official-source collector)

# Required only for Phase 1 live-model analysis. Never commit a real value.
LLM_PROVIDER=openai

# OpenAI provider settings.
OPENAI_API_KEY=
# Current default model; override explicitly when a pinned model is required.
OPENAI_MODEL=gpt-5.6-sol
# Optional; falls back to OPENAI_MODEL.
OPENAI_RED_TEAM_MODEL=

# DeepSeek provider settings. Set LLM_PROVIDER=deepseek to use these values.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# Optional; falls back to DEEPSEEK_MODEL.
DEEPSEEK_RED_TEAM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Phase 2 conservative controlled-collection limits.
SOURCE_COLLECTION_MAX_DOCUMENTS=10
SOURCE_COLLECTION_MAX_ANALYSIS=3

# Phase 3A controlled SMTP delivery. Disabled by default; keep real credentials in backend/.env only.
EMAIL_DELIVERY_ENABLED=false
EMAIL_AUTO_SEND=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Comma-separated addresses. Leave empty to fail closed.
SMTP_TO_ADDRESSES=
# Plaintext SMTP is not supported.
SMTP_SECURITY=STARTTLS
SMTP_TIMEOUT_SECONDS=20
# Optional; otherwise the SMTP_FROM_ADDRESS domain is used for deterministic Message-ID values.
SMTP_MESSAGE_ID_DOMAIN=

# Phase 3B broad-web discovery. Disabled by default; keep real keys in backend/.env only.
WEB_DISCOVERY_ENABLED=false
WEB_SEARCH_PROVIDER=searxng
WEB_SEARCH_FALLBACKS=tavily,exa,you,gemini_google
WEB_SEARCH_MAX_FALLBACKS=1
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
TAVILY_API_KEY=
EXA_API_KEY=
YOU_API_KEY=
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-2.5-flash
# Phase 3C daily analysis only. Flash-Lite may be selected explicitly; there
# is no automatic provider/model fallback and no Search Grounding in analysis.
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_QUOTA_FALLBACK_ENABLED=false
GEMINI_SERVER_FALLBACK_ENABLED=false
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Populate after inspecting the running official image RepoDigest.
SEARXNG_IMAGE_DIGEST=UNVERIFIED

# Optional, separately budgeted news discovery. Disabled by default.
NEWS_DISCOVERY_ENABLED=false
NEWS_SEARCH_PROVIDER=thenewsapi
NEWS_SEARCH_MAX_QUERIES=2
NEWS_SEARCH_MAX_RESULTS_PER_QUERY=3
NEWS_SEARCH_LOOKBACK_DAYS=7
THENEWSAPI_KEY=

# China AI discovery only. TianAPI content is never final evidence or display copy.
TIANAPI_ENABLED=false
TIANAPI_API_KEY=

# Optional China/daily discovery providers. Each Juhe product has a separate key.
JUHE_HEADLINES_ENABLED=false
JUHE_HEADLINES_API_KEY=
JUHE_AI_BRIEF_ENABLED=false
JUHE_AI_BRIEF_API_KEY=
JUHE_STOCK_ENABLED=false
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_MAX_RETRIES=2
WEB_SEARCH_MAX_QUERIES_PER_RUN=24
WEB_SEARCH_MAX_RESULTS_PER_QUERY=5
WEB_FETCH_MAX_PAGES_PER_RUN=10
WEB_TRIAGE_MAX_CANDIDATES_PER_RUN=20
WEB_ANALYZE_MAX_DOCUMENTS_PER_RUN=3
